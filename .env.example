DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"
API_PORT=4000
FRONTEND_URL="http://localhost:3000"
# Multiple frontend origins can be separated by commas.
JWT_SECRET="replace-with-a-long-random-secret"
APIFY_TOKEN=""
APIFY_JOB_ACTOR_ID="curious_coder~linkedin-jobs-scraper"
APIFY_MAX_ITEMS=20
# Optional: only needed if switching to the advanced linkedin-jobs-search-scraper.
APIFY_LINKEDIN_COOKIES='[]'
APIFY_LINKEDIN_USER_AGENT=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_RESUME_FOLDER="job-portal/resumes"
# Optional dedicated stable key for encrypting per-user Slack webhooks.
# Falls back to JWT_SECRET. Changing the key requires reconnecting Slack.
SLACK_ENCRYPTION_KEY=""

# Slack app OAuth credentials (server only).
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# Workspace allowed for Slack sign-in and the bot installed once by the owner.
SLACK_TEAM_ID="T0123456789"
SLACK_BOT_TOKEN=""
# Register this exact HTTPS URL in your Slack app OAuth redirect URLs.
SLACK_LOGIN_REDIRECT_URI="https://your-app.example/auth/slack"
# Must exactly match a registered Slack OAuth redirect URL and serve the frontend Slack page.
SLACK_REDIRECT_URI="https://your-app.example/dashboard/slack"
